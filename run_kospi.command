#!/bin/bash
# 현재 .command 파일이 있는 디렉토리로 이동
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

echo "=================================================="
echo "  코스피 데이터 수집 프로그램을 실행합니다..."
echo "=================================================="
echo ""

# 가상환경의 파이썬으로 kospi_fetch.py 실행
./kospi_venv/bin/python kospi_fetch.py

echo ""
echo "=================================================="
echo "  작업이 완료되었습니다. 창을 닫으려면 아무 키나 누르세요..."
echo "=================================================="
read -p ""
